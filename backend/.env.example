# Copy to .env and fill in. Never commit .env — it holds live API keys.
#
# Note DJANGO_SETTINGS_MODULE does NOT belong here. manage.py and asgi.py call
# os.environ.setdefault() before this file is ever read, so a value here would
# be silently ignored. It defaults to core.settings.local; production sets it
# as a real environment variable.

# --- Django ---
# Generate with:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(64)))"
# Alphanumeric on purpose: docker compose reads this file and would try to
# interpolate any $ characters as shell variables.
DJANGO_SECRET_KEY=

# --- Database ---
# Local dev matches backend/compose.yml. Production uses Neon's POOLED
# connection string (routed via PgBouncer), which must end in ?sslmode=require
DATABASE_URL=postgres://admin:adminpassword@127.0.0.1:5434/stylesense

# --- AI providers ---
# Free-tier keys only. Do NOT attach billing: the public demo is rate-limited,
# not un-abusable, so the free quota is the intended hard ceiling. Worst case
# is a demo that says "daily limit reached", never a bill.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Optional overrides (defaults in settings/base.py are fine locally) ---
# AI_DAILY_CALL_LIMIT=200
# DJANGO_LOG_LEVEL=INFO
# DJANGO_CONN_MAX_AGE=120
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
