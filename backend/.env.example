# Copy to .env and fill in. Never commit .env — it holds live API keys.

# --- Django ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=core.settings.local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Local dev (backend/compose.yml). Production uses the Neon connection string,
# which must include ?sslmode=require
DATABASE_URL=postgres://admin:adminpassword@127.0.0.1:5434/stylesense

# --- AI providers ---
# Free-tier keys only. Do NOT attach billing: the public demo is rate-limited,
# not un-abusable, so the quota is the intended hard ceiling.
GEMINI_API_KEY=
GROQ_API_KEY=
